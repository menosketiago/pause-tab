{
    "name": "Pause Tab",
    "description": "Pause any Chrome tab at will.",
    "version": "1.4.1",
    "manifest_version": 3,
    "action": {
        "default_icon": {
            "16": "icons/pause-tab-16.png",
            "32": "icons/pause-tab-32.png",
            "48": "icons/pause-tab-48.png",
            "128": "icons/pause-tab-128.png"
        },
        "default_popup": "popup/index.html"
    },
    "icons": {
        "16": "icons/pause-tab-16.png",
        "32": "icons/pause-tab-32.png",
        "48": "icons/pause-tab-48.png",
        "128": "icons/pause-tab-128.png"
    },
    "permissions": [
        "activeTab",
        "contextMenus",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "scripts/background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*.ttf",
                "styles/index.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}