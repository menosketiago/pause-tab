{
    "name": "Pause Tab",
    "description": "Pause a tab at will or set time limits per tab.",
    "version": "0.1.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/pause-tab-16.png",
        "32": "icons/pause-tab-32.png",
        "48": "icons/pause-tab-48.png",
        "128": "icons/pause-tab-128.png"
    },
    "action": {
        "default_icon": "icons/pause-tab-16.png"
    },
    "permissions": [
        "contextMenus",
        "scripting",
        "activeTab"
    ],
    "background": {
        "service_worker": "scripts/background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*.ttf",
                "styles/index.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}