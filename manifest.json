{
    "name": "Pause tab",
    "description": "Pause a tab at any time or set up time limits for tabs.",
    "version": "0.1",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup/index.html",
        "default_icon": "icon_default.png"
    },
    "permissions": [
        "contextMenus",
        "scripting",
        "activeTab"
    ],
    "background": {
        "service_worker": "scripts/background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}